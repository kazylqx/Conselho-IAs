# ============================================================
# Conselho de IAs - variaveis de ambiente do BACKEND
#
# 1. Copie este arquivo para ".env"
# 2. Preencha as 3 chaves abaixo (sao gratuitas)
# 3. Nunca comite o .env: ele esta no .gitignore
#
# Em producao (SquareCloud) estas mesmas variaveis vao no painel de
# variaveis de ambiente do app, NAO no codigo.
# ============================================================

# ------------------------------------------------------------
# CHAVES DAS IAs  (obrigatorias para o debate real)
# ------------------------------------------------------------

# Groq  -> https://console.groq.com/keys
# Usada por 2 debatedores: qwen/qwen3.6-27b e openai/gpt-oss-120b
GROQ_API_KEY=

# Google Gemini -> https://aistudio.google.com/app/apikey
# Usada pelo debatedor 3: gemini-3.6-flash
GEMINI_API_KEY=

# OpenRouter -> https://openrouter.ai/keys  (a chave comeca com sk-or-v1-)
# Usada pelo juiz final: nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=

# ------------------------------------------------------------
# CORS / FRONTEND
# ------------------------------------------------------------
# Origem(ns) permitida(s). Aceita varias separadas por virgula.
# Local:     http://localhost:5173
# Producao:  https://seu-site.netlify.app
FRONTEND_URL=

# ------------------------------------------------------------
# SERVIDOR
# ------------------------------------------------------------
# Porta HTTP. Local: 3000. Na SquareCloud (website/API): 80.
PORT=3000
NODE_ENV=development

# Token opcional de protecao da API (uso pessoal).
# Se ficar vazio, a API fica ABERTA (sem autenticacao).
# Se preenchido, o frontend precisa enviar o mesmo valor em VITE_API_TOKEN.
API_TOKEN=

# ------------------------------------------------------------
# MODO DEMONSTRACAO
# ------------------------------------------------------------
# true = nao chama nenhuma API real; todos os agentes usam respostas simuladas.
# Otimo para testar a interface antes de ter as chaves.
MOCK_AI=false

# ------------------------------------------------------------
# OPCIONAIS
# ------------------------------------------------------------

# Identificacao do app no OpenRouter (aparece no painel deles).
# Se vazio, o backend usa FRONTEND_URL e "Conselho de IAs".
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# ------------------------------------------------------------
# BUSCA NA WEB (Tavily) — opcional, mas eh o que permite as IAs
# responderem com dados atuais em vez de so conhecimento treinado.
# Chave gratuita (1.000 creditos/mes): https://app.tavily.com
# ------------------------------------------------------------
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=

# "basic" = 1 credito por busca (padrao) | "advanced" = 2 creditos, mais contexto
WEB_SEARCH_DEPTH=basic
# Tempo maximo de espera por busca, em ms
WEB_SEARCH_TIMEOUT_MS=15000

# Persistencia: arquivo JSON com o historico de debates.
DB_FILE=./data/debates.json
MAX_DEBATES=200

# Limites de execucao.
MAX_CONCURRENT_DEBATES=3
MAX_QUESTION_LENGTH=2000

# Provedores alternativos (deixe vazio se nao usar).
# Basta trocar o `provider` de um agente em src/agents.config.js para usa-los.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
