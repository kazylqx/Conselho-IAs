rules_version = '2';

// ============================================================================
//  REGRAS DO FIRESTORE — Conselho de IAs
// ============================================================================
// Estas regras sao a REAL barreira de seguranca do projeto. A chave web do
// Firebase e publica de proposito; e aqui que se decide quem le e escreve o que.
//
// Como aplicar:
//   Firebase Console -> Firestore Database -> aba "Regras" -> cole isto ->
//   Publicar. (Ou `firebase deploy --only firestore:rules` se usar a CLI.)
//
// Modelo de dados:
//   users/{uid}/debates/{debateId}  -> resumo do debate daquele usuario
//     { id, question, status, createdAt, completedAt, confidence, preview, mock }
//
// A transcricao completa (falas, buscas, veredito) continua no backend; aqui
// fica so o indice por usuario, para o historico ser individual e em tempo real.

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada pessoa manda apenas na propria subcolecao.
    match /users/{uid}/debates/{debateId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      // Escrita validada: sem campo estranho, sem pergunta gigante e sem
      // "confianca" fora da faixa. Evita que um cliente adulterado use o
      // Firestore como armazenamento livre.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
             'id', 'question', 'status', 'createdAt', 'completedAt',
             'confidence', 'preview', 'mock', 'agentCount'
           ])
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 2000
        && request.resource.data.status in ['running', 'completed', 'failed']
        && (
             !('confidence' in request.resource.data)
             || request.resource.data.confidence == null
             || (request.resource.data.confidence is number
                 && request.resource.data.confidence >= 0
                 && request.resource.data.confidence <= 100)
           )
        && (
             !('preview' in request.resource.data)
             || request.resource.data.preview == null
             || (request.resource.data.preview is string
                 && request.resource.data.preview.size() <= 500)
           );
    }

    // Qualquer outro caminho fica fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
