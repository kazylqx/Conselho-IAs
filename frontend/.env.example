# ============================================================
# Conselho de IAs - variaveis de ambiente do FRONTEND
# Copie para ".env" (local) ou configure no painel da Netlify.
#
# ATENCAO: tudo que comeca com VITE_ vai para o navegador.
# NUNCA coloque chaves de IA aqui. Elas ficam somente no backend.
# ============================================================

# URL do backend (sem barra no final).
# Local:      http://localhost:3000
# SquareCloud: https://seu-app.squareweb.app
VITE_BACKEND_URL=http://localhost:3000

# Opcional: precisa ser igual ao API_TOKEN do backend.
# Deixe vazio se o backend estiver sem token.
VITE_API_TOKEN=

# ============================================================
# FIREBASE (login + historico por usuario)
#
# Estes valores NAO sao segredo: a chave web identifica o projeto e e feita
# para ficar no navegador. Quem protege os dados sao as regras do Firestore
# (ver firestore.rules na raiz do repositorio).
#
# Onde achar: Firebase Console -> Configuracoes do projeto -> Seus apps -> Web.
# Se ficarem vazios, o site roda em modo anonimo (sem login, sem historico).
# ============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
