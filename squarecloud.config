// ============================================================================
//  Configuracao da SquareCloud — RAIZ DO REPOSITORIO
// ============================================================================
// A integracao automatica com o GitHub deploya o repositorio INTEIRO (nao existe
// opcao de subpasta). Como este projeto eh um monorepo (/backend e /frontend),
// eh este arquivo — o da raiz — que a SquareCloud le nos deploys automaticos.
//
// Por isso MAIN aponta para backend/src/server.js e o package.json da raiz
// declara as dependencias do backend (o npm install roda na raiz do app).
//
// O arquivo backend/squarecloud.config continua existindo para quem preferir
// subir um zip apenas da pasta backend, na mao.
//
// Lembrete: na SquareCloud a aplicacao web precisa escutar na porta 80
// (defina PORT=80 nas variaveis de ambiente do painel).
DISPLAY_NAME=Conselho de IAs API
DESCRIPTION=Backend do Conselho de IAs - orquestra debates entre multiplas IAs (REST + Socket.IO)
MAIN=backend/src/server.js
RUNTIME=nodejs
VERSION=recommended
MEMORY=512
AUTORESTART=true
START=npm start
SUBDOMAIN=conselho-de-ias
